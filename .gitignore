# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# Home Assistant
.homeassistant/
*.db
*.log

# IDE
# Exception assumee a la regle "on versionne toujours .vscode/" : depot PUBLIC
# destine a HACS, et ce .vscode/ ne contient que la couleur d'identification de
# fenetre - inutile de l'imposer a qui clone. (HACS n'interdit rien ici.)
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Claude Code : la config partagée est versionnée, les préférences personnelles
# (settings.local.json) et les worktrees restent hors du dépôt. Dépôt PUBLIC.
# .claude/* ignore le CONTENU du dossier, ce qui permet à la négation de marcher.
.claude/*
!.claude/settings.json

